# ===== Supabase =====
# 浏览器可见（仅 anon key，配合 RLS 使用）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 仅服务端使用，绝不能加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=

# ===== LLM（OpenAI 兼容接口，仅服务端使用）=====
LLM_API_KEY=
# 例如 DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
# 例如 qwen-plus / kimi-k2-turbo / glm-4-air
LLM_MODEL=

# 比赛版后端。CATJUDGE_SITE_ORIGINS 填实际 Sites 来源，无尾斜杠。
# CATJUDGE_CONTEST_MODE=1
# CATJUDGE_SITE_ORIGINS=https://your-site.example
# CATJUDGE_MODEL_DAILY_LIMIT=100
# CATJUDGE_MODEL_MINUTE_LIMIT=8
